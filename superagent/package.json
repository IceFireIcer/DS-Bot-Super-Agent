{
  "name": "ds-superagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./postgres-storage": {
      "types": "./dist/postgres-storage.d.ts",
      "default": "./dist/postgres-storage.js"
    },
    "./session-persistence": {
      "types": "./dist/session-persistence.d.ts",
      "default": "./dist/session-persistence.js"
    },
    "./session-persistence-postgres": {
      "types": "./dist/session-persistence-postgres.d.ts",
      "default": "./dist/session-persistence-postgres.js"
    },
    "./client-access": {
      "types": "./dist/client-access.d.ts",
      "default": "./dist/client-access.js"
    },
    "./client-gateway": {
      "types": "./dist/client-gateway.d.ts",
      "default": "./dist/client-gateway.js"
    },
    "./watchdog": {
      "types": "./dist/watchdog.d.ts",
      "default": "./dist/watchdog.js"
    },
    "./watchdog-process": {
      "types": "./dist/watchdog-process.d.ts",
      "default": "./dist/watchdog-process.js"
    },
    "./supervisor": {
      "types": "./dist/supervisor.d.ts",
      "default": "./dist/supervisor.js"
    },
    "./supervisor-session": {
      "types": "./dist/supervisor-session.d.ts",
      "default": "./dist/supervisor-session.js"
    },
    "./config-instructions": {
      "types": "./dist/config-instructions.d.ts",
      "default": "./dist/config-instructions.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "lint": "oxlint -c ../ds-bot/.oxlintrc.json src test scripts dev",
    "mock": "npm run build && node dev/mock.mjs"
  },
  "bin": {
    "ds-superagent-watchdog": "dist/watchdog-cli.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.4",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.4",
    "node-pty": "1.2.0-beta.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.11.0-beta.19",
    "esbuild": "0.28.2",
    "oxlint": "1.76.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.4": true,
    "esbuild@0.28.2": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true
  }
}
